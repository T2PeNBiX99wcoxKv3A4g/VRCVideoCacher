<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:l="using:Jeek.Avalonia.Localization"
             xmlns:vm="clr-namespace:VRCVideoCacher.ViewModels"
             x:Class="VRCVideoCacher.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="4,0,4,16">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,10">
                <TextBlock Text="{l:Localize About}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
            
            <!-- App Details Card -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimarySubtleBrush}" BorderBrush="#6366f140" BorderThickness="1" CornerRadius="12" Width="44" Height="44">
                            <mi:MaterialIcon Kind="PlayCircleOutline" Width="24" Height="24" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="VRCVideoCacher" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource PrimarySubtleBrush}" BorderBrush="#6366f133" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version, StringFormat='{}v{0}'}" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CreatedBy}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="{StaticResource DividerBrush}" Margin="0,4"/>

                    <TextBlock Text="Community &amp; Source" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnDiscordClick" ToolTip.Tip="Discord" Padding="14, 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Forum" Width="18" Height="18" Foreground="#5865f2"/>
                                <TextBlock Text="Discord" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnGitHubClick" ToolTip.Tip="GitHub" Padding="14, 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Github" Width="18" Height="18"/>
                                <TextBlock Text="GitHub" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnSteamClick" ToolTip.Tip="Steam" Padding="14, 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Steam" Width="18" Height="18" Foreground="#00adee"/>
                                <TextBlock Text="Steam" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Feedback & Issues Card -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="BugOutline" Width="18" Height="18" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="{l:Localize ReportAnIssue}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="Found a bug or have a suggestion? Get in touch with us on GitHub or Discord."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button ToolTip.Tip="{l:Localize OpenIssueOnGitHub}" Click="OnGitHubIssueClick" Padding="14, 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Github" Width="18" Height="18"/>
                                <TextBlock Text="{l:Localize OpenIssueOnGitHub}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip.Tip="{l:Localize JoinOurDiscord}" Click="OnDiscordIssueClick" Padding="14, 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Forum" Width="18" Height="18" Foreground="#5865f2"/>
                                <TextBlock Text="{l:Localize JoinOurDiscord}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>