<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VRCVideoCacher.Views.ConfirmWindow"
        Title="VRCVideoCacher"
        Width="460"
        CanResize="False"
        SizeToContent="Height"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Border Classes="card" Margin="14" Padding="18">
        <StackPanel Spacing="16">
            <TextBlock x:Name="TitleTextBlock" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                <Button x:Name="CancelButton" Width="95" Padding="12,7" HorizontalContentAlignment="Center"
                        Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Width="95" Classes="danger" HorizontalContentAlignment="Center"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>