<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="4,0,4,14">
            <TextBlock Text="{l:Localize Settings}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

            <!-- Status Message -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceElevatedBackgroundBrush}" CornerRadius="6" Padding="10,4" Margin="12,0" VerticalAlignment="Center"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{Binding StatusMessageColor}"/>
            </Border>

            <Button Grid.Column="2" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,10,0" Padding="12,7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="Undo" Width="16" Height="16"/>
                    <TextBlock Text="{l:Localize Reset}" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Command="{Binding SaveSettingsCommand}"
                    Classes="accent" Classes.pending="{Binding HasChanges}" Padding="16,7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                    <TextBlock Text="{l:Localize Save}" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="4,0,4,16">
                <!-- General Settings -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="TuneVariant" Width="18" Height="18" Foreground="{StaticResource PrimaryLightBrush}"/>
                            <TextBlock Text="{l:Localize General}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="140, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{l:Localize Language}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableLanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Compact two-column layout for the general toggles -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="16" RowSpacing="10" Margin="0,4,0,0">
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding CloseToTray}" Content="{l:Localize CloseToTray}"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding StartMinimized}" Content="{l:Localize StartMinimized}"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding StartWithSteamVr}" Content="{l:Localize StartWithSteamVr}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ErrorPopups}" Content="{l:Localize ErrorPopups}"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding ShowAdvanced}" Content="{l:Localize ShowAdvancedSettings}" Foreground="{StaticResource PrimaryLightBrush}"/>
                    </StackPanel>
                </Border>

                <!-- YouTube SABR Options -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="Youtube" Width="18" Height="18" Foreground="#ef4444"/>
                            <TextBlock Text="{l:Localize YouTubeSabrOptions}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding PreferSabrStreaming}"
                                  Content="{l:Localize SabrPreferStreaming}"
                                  ToolTip.Tip="{l:Localize SabrPreferStreamingTooltip}"/>

                        <Grid ColumnDefinitions="180, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{l:Localize SabrMaxResolution}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ResolutionOptions}"
                                      SelectedItem="{Binding SabrMaxResolution}"
                                      ToolTip.Tip="{l:Localize SabrMaxResolutionTooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static vm:ResolutionLabelConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="10" IsVisible="{Binding ShowAdvanced}">
                            <CheckBox IsChecked="{Binding SabrFilterDrcAudio}"
                                      Content="{l:Localize SabrFilterDrcAudio}"
                                      ToolTip.Tip="{l:Localize SabrFilterDrcAudioTooltip}"/>
                            <CheckBox IsChecked="{Binding SabrFilterSuperResolution}"
                                      Content="{l:Localize SabrFilterSuperResolution}"
                                      ToolTip.Tip="{l:Localize SabrFilterSuperResolutionTooltip}"/>
                            <CheckBox IsChecked="{Binding SabrFilterVoiceBoostedAudio}"
                                      Content="{l:Localize SabrFilterVoiceBoostedAudio}"
                                      ToolTip.Tip="{l:Localize SabrFilterVoiceBoostedAudioTooltip}"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowAdvanced}">
                            <TextBlock Text="{l:Localize SabrAdditionalArgs}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding SabrAdditionalArgs}" PlaceholderText="Optional arguments"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Download Settings -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="CloudDownloadOutline" Width="18" Height="18" Foreground="{StaticResource InfoBrush}"/>
                            <TextBlock Text="{l:Localize DownloadSettings}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="16">
                            <CheckBox Grid.Column="0" IsChecked="{Binding YtdlUseCookies}" Content="{l:Localize UseYouTubeCookies}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding YtdlAutoUpdate}" Content="{l:Localize AutoUpdateUtils}"/>
                        </Grid>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowAdvanced}">
                            <TextBlock Text="{l:Localize AdditionalYtdlpArgs}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding YtdlAdditionalArgs}" PlaceholderText="Optional arguments"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding ShowAdvanced}">
                            <TextBlock Text="{l:Localize GitHubToken}" Foreground="{StaticResource TextSecondaryBrush}"
                                       ToolTip.Tip="{l:Localize GitHubTokenTooltip}"/>
                            <TextBox Text="{Binding GitHubToken}" PasswordChar="•" PlaceholderText="ghp_..."/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:Localize PreferredDubLanguage}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding YtdlDubLanguage}" PlaceholderText="Leave empty for original"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cache Settings -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="Harddisk" Width="18" Height="18" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{l:Localize CacheSettings}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="160, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{l:Localize CachePathLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding CachedAssetPath}" PlaceholderText="CachedAssets"/>
                        </Grid>

                        <Grid ColumnDefinitions="160, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{l:Localize MaxCacheSizeLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding CacheMaxSizeInGb}" Minimum="0" Maximum="10000" Increment="1" FormatString="0.#"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding CacheYouTube}" Content="{l:Localize CacheYouTubeVideos}"/>

                        <StackPanel Spacing="10" Margin="24,0,0,0" IsVisible="{Binding CacheYouTube}">
                            <Grid ColumnDefinitions="160, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{l:Localize MaxYouTubeResolution}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding CacheYouTubeMaxResolution}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static vm:ResolutionLabelConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="160, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{l:Localize MaxVideoLength}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding CacheYouTubeMaxLength}" Minimum="1" Increment="10"/>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="16" RowSpacing="10" Margin="0,4,0,0">
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding CachePyPyDance}" Content="{l:Localize CachePyPyDanceVideos}"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding CacheVRDancing}" Content="{l:Localize CacheVRDancingVideos}"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding CacheGeneric}" Content="{l:Localize CacheGenericVideos}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding CacheOnly}" Content="{l:Localize OnlyServeCachedVideos}"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding RedirectVRDancing}" Content="{l:Localize RedirectVRDancing}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced sections (revealed by the "Show advanced settings" toggle) -->
                <StackPanel Spacing="16" IsVisible="{Binding ShowAdvanced}">
                    <!-- Server Settings -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="ServerNetwork" Width="18" Height="18" Foreground="{StaticResource PrimaryLightBrush}"/>
                                <TextBlock Text="{l:Localize ServerSettings}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="160, *" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{l:Localize WebServerUrl}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Column="1" Text="{Binding WebServerUrl}" PlaceholderText="http://localhost:9696"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Game Patching -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="GamepadVariantOutline" Width="18" Height="18" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{l:Localize GamePatching}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                <CheckBox Grid.Column="0" IsChecked="{Binding PatchVRC}" Content="{l:Localize PatchVRChat}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding PatchResonite}" Content="{l:Localize PatchResonite}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Updates -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="Update" Width="18" Height="18" Foreground="{StaticResource InfoBrush}"/>
                                <TextBlock Text="{l:Localize Updates}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding AutoUpdate}" Content="{l:Localize AutoUpdateVRCVideoCacher}"/>
                        </StackPanel>
                    </Border>

                    <!-- Blocked URLs -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="Cancel" Width="18" Height="18" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="{l:Localize BlockedUrls}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding AddBlockedUrlCommand}" Padding="10, 6">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                        <TextBlock Text="{l:Localize Add}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding BlockedUrls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,3">
                                            <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Classes="subtle-danger"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveBlockedUrlCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="6" Margin="0,10,0,0">
                                <TextBlock Text="{l:Localize BlockedUrlRedirect}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding BlockRedirect}" PlaceholderText="Redirect URL"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Redirect URLs -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="DirectionsFork" Width="18" Height="18" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Text="{l:Localize RedirectUrls}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding AddRedirectUrlCommand}" Padding="10, 6">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                        <TextBlock Text="{l:Localize Add}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RedirectUrls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, *, Auto" Margin="0,3">
                                            <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Source pattern"/>
                                            <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding RedirectUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Target URL"/>
                                            <Button Grid.Column="2" Margin="6,0,0,0" Classes="subtle-danger"
                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveRedirectUrlCommand}"
                                                    CommandParameter="{Binding}">
                                                <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>

        <!-- Unsaved changes -> pulse the Save button so it's impossible to miss -->
        <Style Selector="Button.accent.pending">
            <Setter Property="Background" Value="#10b981"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.65"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
</UserControl>
