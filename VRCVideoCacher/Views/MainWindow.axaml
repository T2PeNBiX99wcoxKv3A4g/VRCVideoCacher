<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VRCVideoCacher.ViewModels"
        xmlns:views="using:VRCVideoCacher.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:l="using:Jeek.Avalonia.Localization"
        xmlns:viewModels="clr-namespace:VRCVideoCacher.ViewModels"
        x:Class="VRCVideoCacher.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://VRCVideoCacher/Assets/icon.ico"
        Width="1040" Height="720"
        MinWidth="840" MinHeight="520"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*, Auto">
        <!-- Main Content -->
        <Grid Grid.Row="0" ColumnDefinitions="220, *">
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SidebarBackgroundBrush}" 
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14, 16, 14, 16">
                <DockPanel>
                    <!-- App Banner / Logo Header -->
                    <Border DockPanel.Dock="Top" Margin="0,4,0,20" HorizontalAlignment="Center">
                        <Image Source="avares://VRCVideoCacher/Assets/SmallBanner.png"
                               MaxWidth="180"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Spacing="6" DockPanel.Dock="Top">
                        <Button Command="{Binding NavigateToDashboardCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsDashboardActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="ViewDashboardOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize Dashboard}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToHistoryCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsHistoryActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="History" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize History}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToCacheBrowserCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsCacheBrowserActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="FolderPlayOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize CacheBrowser}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToDownloadQueueCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsDownloadQueueActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="DownloadOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize Downloads}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToSettingsCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsSettingsActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="CogOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize Settings}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToLogViewerCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsLogViewerActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="ConsoleLine" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize Logs}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding NavigateToAboutCommand}"
                                Classes="nav-button"
                                Classes.active="{Binding IsAboutActive}">
                            <Grid ColumnDefinitions="24, *">
                                <mi:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="19" Height="19" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{l:Localize About}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16, 12, 16, 12">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:CacheBrowserViewModel}">
                        <views:CacheBrowserView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadQueueViewModel}">
                        <views:DownloadQueueView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
                        <views:LogViewerView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                        <views:AboutView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" 
                Background="{StaticResource SidebarBackgroundBrush}" 
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16, 7">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="4" Minimum="0" Maximum="1"
                                 CornerRadius="2"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding StatusShowBar}"
                                 IsIndeterminate="{Binding StatusIndeterminate}"
                                 Value="{Binding StatusProgress}"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{Binding StatusColor}" 
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" 
                        Background="{StaticResource SurfaceElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10, 3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="Harddisk" Width="14" Height="14" Foreground="{StaticResource PrimaryLightBrush}"/>
                        <TextBlock Text="{Binding CacheStatusText}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
