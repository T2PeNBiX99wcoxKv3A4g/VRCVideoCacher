<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.CacheBrowserView"
             x:DataType="vm:CacheBrowserViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="4,0,4,4">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="{l:Localize CacheBrowser}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding RefreshCacheCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize Refresh}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <Button Command="{Binding OpenInExplorerCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize OpenFolder}">
                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <Button Command="{Binding DeleteAllCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize DeleteAllCache}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16"/>
                        <TextBlock Text="{l:Localize DeleteAllCache}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox Text="{Binding SearchFilter}" 
                     PlaceholderText="{l:Localize SearchVideosWatermark}"
                     Background="{StaticResource SurfaceElevatedBackgroundBrush}"
                     BorderBrush="{StaticResource CardBorderBrush}"
                     Padding="10, 8">
                <TextBox.InnerLeftContent>
                    <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,6,0" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <!-- Video List -->
        <Border Grid.Row="2" Classes="card" Padding="8">
            <ListBox ItemsSource="{Binding FilteredVideos}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CacheItemViewModel">
                        <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                                BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Localize OpenUrl}" Command="{Binding OpenOnYouTubeCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="Youtube" Width="16" Height="16" Foreground="#ef4444"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize CopyUrl}" Command="{Binding CopyUrlCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource PrimaryLightBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{l:Localize DeleteHistoryEntry}" Command="{Binding DeleteCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="120" Height="68" CornerRadius="6" ClipToBounds="True" Background="#1c1c24">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Video Info -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <TextBlock Text="{Binding VideoId}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Extension}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                        <Border Background="{StaticResource InfoSubtleBrush}" BorderBrush="#0ea5e933" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="11" Foreground="{StaticResource InfoBrush}" FontWeight="Medium"/>
                                        </Border>
                                        <TextBlock Text="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                   VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0">
                                    <Button Command="{Binding OpenOnYouTubeCommand}" Classes="icon-button" ToolTip.Tip="Open on YouTube">
                                        <mi:MaterialIcon Kind="Youtube" Width="18" Height="18" Foreground="#ef4444"/>
                                    </Button>
                                    <Button Command="{Binding CopyUrlCommand}" Classes="icon-button" ToolTip.Tip="Copy Local URL">
                                        <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" Classes="subtle-danger" ToolTip.Tip="Delete" Padding="8">
                                        <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status Summary Bar -->
        <Border Grid.Row="3" Classes="card-subtle" Margin="0,10,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
