<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.DownloadQueueView"
             x:DataType="vm:DownloadQueueViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="4,0,4,4">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
            <TextBlock Text="{l:Localize DownloadQueue}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding RefreshQueueCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize Refresh}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <Button Command="{Binding ClearQueueCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize ClearQueue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16"/>
                        <TextBlock Text="{l:Localize ClearQueue}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Current Download -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="DownloadNetworkOutline" Width="18" Height="18" Foreground="{StaticResource PrimaryLightBrush}"/>
                    <TextBlock Text="{l:Localize CurrentDownload}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Active download item -->
                <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                        BorderBrush="{StaticResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14"
                        IsVisible="{Binding CurrentDownload, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Background="{StaticResource InfoSubtleBrush}" BorderBrush="#0ea5e933" BorderThickness="1" CornerRadius="20" Width="40" Height="40">
                            <mi:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding CurrentDownload.VideoId}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                            <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CurrentDownload.UrlType}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource InfoSubtleBrush}" BorderBrush="#0ea5e944" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentStatus}" Foreground="{StaticResource InfoBrush}" FontWeight="Medium" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- No active download -->
                <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                        BorderBrush="{StaticResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16"
                        IsVisible="{Binding CurrentDownload, Converter={x:Static ObjectConverters.IsNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{l:Localize NoActiveDownload}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Manual Download -->
        <Border Grid.Row="2" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="LinkPlus" Width="18" Height="18" Foreground="{StaticResource PrimaryLightBrush}"/>
                    <TextBlock Text="{l:Localize AddManualDownload}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding ManualUrl}" 
                             PlaceholderText="{l:Localize EnterVideoUrl}"
                             Background="{StaticResource SurfaceElevatedBackgroundBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             Padding="10, 8">
                        <TextBox.InnerLeftContent>
                            <mi:MaterialIcon Kind="LinkVariant" Width="16" Height="16" Margin="10,0,6,0" Foreground="{StaticResource TextMutedBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Command="{Binding AddManualDownloadCommand}" Classes="primary" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="{l:Localize Add}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource SuccessBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Queue List -->
        <Border Grid.Row="3" Classes="card">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="FormatListNumbered" Width="18" Height="18" Foreground="{StaticResource PrimaryLightBrush}"/>
                        <TextBlock Text="{l:Localize QueuedDownloads}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PrimarySubtleBrush}" CornerRadius="10" Padding="8,2"
                            IsVisible="{Binding QueuedDownloads.Count, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}">
                        <TextBlock Text="{Binding QueuedDownloads.Count, StringFormat='{}{0}'}" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding QueuedDownloads}"
                         Background="Transparent"
                         IsVisible="{Binding QueuedDownloads.Count, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                            <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                                    BorderBrush="{StaticResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" Background="{StaticResource WarningSubtleBrush}" BorderBrush="#f59e0b33" BorderThickness="1" CornerRadius="16" Width="32" Height="32">
                                        <mi:MaterialIcon Kind="ClockOutline" Width="16" Height="16" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding VideoId}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding UrlType}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            </Border>
                                            <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding Format, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Format}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !QueuedDownloads.Count}">
                    <mi:MaterialIcon Kind="InboxOutline" Width="40" Height="40" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Localize QueueIsEmpty}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
