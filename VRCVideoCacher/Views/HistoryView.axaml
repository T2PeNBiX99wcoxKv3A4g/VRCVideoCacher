<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, *, Auto" Margin="4,0,4,4">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
            <TextBlock Text="{l:Localize History}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{l:Localize HistoryMaxSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding MaxSize}" Minimum="1" Maximum="1000000" Increment="100"
                                   FormatString="0" Width="120" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Command="{Binding ClearAllCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize ClearAllHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16"/>
                        <TextBlock Text="{l:Localize ClearAllHistory}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize Refresh}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- History List -->
        <Border Grid.Row="1" Classes="card" Padding="8">
            <ListBox ItemsSource="{Binding HistoryItems}"
                     Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                                BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="120" Height="68" CornerRadius="6" ClipToBounds="True" Background="#1c1c24">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                               IsVisible="{Binding HasAuthor}"/>
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd MMM yyyy HH:mm}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Type Badge -->
                                <Border Grid.Column="2" Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding TypeBadge}" FontSize="11" FontWeight="Medium" Foreground="White"/>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenUrlCommand}" Classes="icon-button" ToolTip.Tip="Open URL">
                                        <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding CopyUrlCommand}" Classes="icon-button" ToolTip.Tip="Copy URL">
                                        <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize DeleteHistoryEntry}" Padding="8">
                                        <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Classes="card-subtle" Margin="0,10,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
