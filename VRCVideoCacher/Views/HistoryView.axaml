<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, *, Auto" Margin="0,0,0,4">
        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="{l:Localize History}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Historical playback records and video stream intercepts from VRChat" 
                           FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{StaticResource SurfaceElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8, 4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{l:Localize HistoryMaxSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <NumericUpDown Value="{Binding MaxSize}" Minimum="1" Maximum="1000000" Increment="100"
                                       FormatString="0" Width="200" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Button Command="{Binding RefreshCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize Refresh}">
                    <mi:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <Button Command="{Binding ClearAllCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize ClearAllHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="DeleteSweepOutline" Width="18" Height="18"/>
                        <TextBlock Text="{l:Localize ClearAllHistory}" FontSize="12.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- History List Container -->
        <Border Grid.Row="1" Classes="card" Padding="8">
            <ListBox ItemsSource="{Binding HistoryItems}"
                     Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border Background="{StaticResource SurfaceSubtleBackgroundBrush}" 
                                BorderBrush="{StaticResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="12"
                                Margin="0,2">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Localize OpenUrl}" Command="{Binding OpenUrlCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{StaticResource PrimaryLightBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Localize CopyUrl}" Command="{Binding CopyUrlCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{l:Localize DeleteHistoryEntry}" Command="{Binding DeleteCommand}">
                                        <MenuItem.Icon>
                                            <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <!-- Thumbnail Cover -->
                                <Border Grid.Column="0" Width="130" Height="74" CornerRadius="8" ClipToBounds="True" Background="{StaticResource MediaThumbnailBackgroundBrush}">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Video Metadata Info -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Text="{Binding Author}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               IsVisible="{Binding HasAuthor}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource SurfaceElevatedBackgroundBrush}" 
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5" Padding="6,2">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd MMM yyyy HH:mm}}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Source Type Badge -->
                                <Border Grid.Column="2" Background="{Binding TypeBadgeColor}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding TypeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenUrlCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize OpenUrl}">
                                        <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding CopyUrlCommand}" Classes="icon-button" ToolTip.Tip="{l:Localize CopyUrl}">
                                        <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" Classes="subtle-danger" ToolTip.Tip="{l:Localize DeleteHistoryEntry}" Padding="8">
                                        <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status Summary Bar -->
        <Border Grid.Row="2" Classes="card-subtle" Margin="0,12,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>